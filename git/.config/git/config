[user]
  name = Drew Reeve
  email = dru.reeve@gmail.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKzCvDYbBhQReFUW60WX8abSOWbQav72LVV9Llm+AJJ2
[gpg]
  format = ssh
[alias]
  ci = commit
  co = checkout
  aa = add --all
  ap = add --patch
  ca = commit --amend
  trust = "!mkdir -p .git/safe"
  st = status -sb
  lg = log --graph --oneline
[branch]
  sort = -committerdate
[column]
  ui = auto
[commit]
  verbose = true
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
[core]
  autocrlf = input
[init]
  defaultBranch = main
[include]
  path = ~/.gitconfig.local
[rebase]
  autosquash = true
[push]
	autoSetupRemote = true
	followTags = true
[rerere]
  enabled = true
  autoupdate = true
[merge]
	conflictstyle = zdiff3
