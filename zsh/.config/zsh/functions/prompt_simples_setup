# Simple prompt similar to pure
#
#   user@host in ~/path   branch*+?⇣⇡ rebase-interactive ≡ 42s
#   ❯
#
# user@host only shows over SSH, or as root

prompt_simples_preexec() {
  typeset -g prompt_simples_start=$EPOCHREALTIME
}

prompt_simples_precmd() {
  emulate -L zsh

  local p=$prompt_newline$prompt_simples_user

  # Full path with $HOME abbreviated to ~
  p+='%B%F{cyan}%~%f%b'

  prompt_simples_git

  # Duration of the last command, if it took long enough to be interesting.
  # Unset so pressing enter on an empty line doesn't show it again
  if (( $+prompt_simples_start )); then
    local -i secs=$(( EPOCHREALTIME - prompt_simples_start ))
    unset prompt_simples_start
    if (( secs >= 2 )); then
      local duration=$(( secs % 60 ))s
      (( secs >= 60 )) && duration=$(( secs % 3600 / 60 ))m$duration
      (( secs >= 3600 )) && duration=$(( secs / 3600 ))h$duration
      p+="%B%F{yellow} $duration%f%b"
    fi
  fi

  # %(?..) picks the colour from the last command's exit status. The first
  # prompt gets the status of whatever ran last in .zshrc, so ignore it there
  local colour='%(?.%F{magenta}.%F{red})'
  if (( $+prompt_simples_first )); then
    colour='%F{magenta}'
    unset prompt_simples_first
  fi
  p+=$prompt_newline$colour'❯%f '

  PROMPT=$p
}

# Git info: branch, * for unstaged changes, + for staged changes,
# ? for untracked files, an in-progress action such as a rebase,
# ⇣⇡ when behind/ahead of upstream and ≡ when stashed.
# Appends to $p from prompt_simples_precmd, saving a subshell
prompt_simples_git() {
  # For (#b) and <-> below
  setopt localoptions extendedglob

  # Empty outside a repo, and inside .git where --show-toplevel is an error
  local git_dir=${${(f)"$(command git rev-parse --show-toplevel --absolute-git-dir 2>/dev/null)"}[2]}
  [[ -n $git_dir ]] || return

  # (r) gives the first element matching a pattern.
  # Patterns use ? for a space, seems to avoid a quirk in tree-sitter
  local -a lines=(${(f)"$(command git --no-optional-locks status --porcelain=v2 --branch --show-stash 2>/dev/null)"})

  local branch=${${lines[(r)\#?branch.head?*]}##* }
  # Detached HEAD, so use the short commit hash
  [[ $branch == '(detached)' ]] && branch=${${${lines[(r)\#?branch.oid?*]}##* }[1,7]}

  # Changed files are "1 XY ..." or "2 XY ..." where X is the staged status,
  # Y the unstaged one, and . means unchanged. Conflicted files are "u XY ...",
  # and only count as unstaged
  local markers
  [[ -n ${lines[(r)[12]??[^.]*]}${lines[(r)u?*]} ]] && markers+='*'
  [[ -n ${lines[(r)[12]?[^.]*]} ]] && markers+=+
  [[ -n ${lines[(r)\??*]} ]] && markers+='?'

  # Line is "# branch.ab +<ahead> -<behind>", and (#b) captures into $match
  if [[ ${lines[(r)\#?branch.ab?*]} == (#b)*+(<->)' -'(<->) ]]; then
    (( match[2] )) && markers+=⇣
    (( match[1] )) && markers+=⇡
  fi

  # The same labels as fish's fish_print_git_action, where the first match wins
  local file label action
  for file label in \
      rebase-apply/rebasing rebase \
      rebase-apply/applying apply \
      rebase-apply rebase/apply \
      rebase-merge/interactive rebase-interactive \
      rebase-merge rebase-merge \
      MERGE_HEAD merge \
      CHERRY_PICK_HEAD cherry-pick \
      REVERT_HEAD revert \
      BISECT_LOG bisect
  do
    [[ -e $git_dir/$file ]] && { action=$label; break }
  done
  [[ $action == (cherry-pick|revert) && -d $git_dir/sequencer ]] && action+=-sequence

  # Escape % so a branch name can't inject prompt sequences
  p+="%B%F{magenta}  "$'\uf418'" ${branch//\%/%%}%F{red}$markers"
  [[ -n $action ]] && p+="%F{yellow} $action"
  [[ -n ${lines[(r)\#?stash?*]} ]] && p+="%F{cyan} ≡"
  p+='%f%b'
}

prompt_simples_setup() {
  # No subst, so nothing from git (like a branch name) is ever expanded
  prompt_opts=(cr percent sp)

  # Neither changes during a session, so build user@host once.
  # %(!..) makes the username red as root
  typeset -g prompt_simples_user=
  if [[ -n $SSH_CONNECTION ]] || (( EUID == 0 )); then
    prompt_simples_user='%B%F{yellow}%(!.%F{red}.)%n%F{yellow}'
    [[ -n $SSH_CONNECTION ]] && prompt_simples_user+='@%m'
    prompt_simples_user+='%f%b in '
  fi

  typeset -g prompt_simples_first=1

  zmodload zsh/datetime
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd prompt_simples_precmd
  add-zsh-hook preexec prompt_simples_preexec
}

prompt_simples_setup "$@"

# vim: ft=zsh
